{
  "version": 1,
  "projects": {
    "tm-wedding": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "outputPath": "dist/tm-wedding"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "400kB",
                  "maximumError": "550kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "22kB",
                  "maximumError": "25kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "emulator": {
              "optimization": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/app/config/firebase.config.ts",
                  "with": "src/app/config/firebase.emulator.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "tm-wedding:build:production"
            },
            "development": {
              "buildTarget": "tm-wedding:build:development"
            },
            "emulator": {
              "buildTarget": "tm-wedding:build:emulator"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
