{
  "name": "tm-wedding",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --allowed-hosts",
    "build": "ng build",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tm-wedding 'vitest run --config vitest.rules.config.ts'",
    "emulators": "firebase emulators:start --project demo-tm-wedding",
    "deploy": "npm run build && firebase deploy --only firestore,hosting",
    "start:emulators": "ng serve --host 127.0.0.1 --configuration emulator",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "firebase": "12.19.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^15.0.0",
    "@playwright/test": "^1.58.0"
  }
}
